# Copy to .env on the server (cp .env.example .env), fill in, then: chmod 600 .env
# Never commit .env to Git.

APP_ENV=production

# The address people will visit, with no https:// in front. It must already point at this server.
DOMAIN=stocks.example.com

# Signs login cookies. Make one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-64-random-hex-characters

# Set to true to expose the interactive API docs at /docs (handy for showing the API in a demo)
ENABLE_DOCS=false
